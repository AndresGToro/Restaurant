<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".RestaurantApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Restaurant"
        tools:targetApi="31">
        <activity
            android:name=".presentation.main.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Restaurant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Add your MenuPrincipal activity -->
        <activity
            android:name=".presentation.home.MenuPrincipal"
            android:label="@string/app_name"
            android:theme="@style/Theme.Restaurant" />

        <activity
            android:name=".presentation.usuario.Usuario"
            android:label="@string/app_name"
            android:theme="@style/Theme.Restaurant" />

        <activity
            android:name=".presentation.iva.IvaUpdate"
            android:label="@string/app_name"
            android:theme="@style/Theme.Restaurant" />

        <activity
            android:name=".presentation.producto.Producto"
            android:label="@string/app_name"
            android:theme="@style/Theme.Restaurant" />

        <activity
            android:name=".presentation.producto.ProductosVisualizar"
            android:label="@string/app_name"
            android:theme="@style/Theme.Restaurant" />

        <activity
            android:name=".presentation.navigation.bottomnav.PantallaPrincipal"
            android:label="@string/app_name"
            android:theme="@style/Theme.Restaurant" />

        <service
            android:name=".core.notifications.RestaurantMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
