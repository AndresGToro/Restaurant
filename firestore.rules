rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return hasProfile()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.cargo
        : "CLIENTE";
    }

    function isAdmin() {
      return role() == "ADMIN";
    }

    function isMesero() {
      return role() == "MESERO";
    }

    function isCajero() {
      return role() == "CAJERO";
    }

    function isCocina() {
      return role() == "COCINA";
    }

    function isStaff() {
      return isAdmin() || isMesero() || isCajero() || isCocina();
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow read, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isCocina();
    }

    match /orders/{orderId} {
      allow create: if isMesero() || isCajero() || isAdmin();
      allow read: if isStaff();
      allow update: if isMesero() || isCajero() || isCocina() || isAdmin();
      allow delete: if isAdmin() || isCajero();
    }

    match /messages/{messageId} {
      allow read, create: if isStaff();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
  }
}
